<Window x:Class="Presensi.DaftarWajahWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daftar Wajah Siswa"
        Icon="Assets/app.ico"
        Height="640" Width="980" MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Background="#1A1D1F"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Kiri: kamera + petunjuk langkah -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <TextBlock x:Name="PetunjukText" DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Pilih kelas dan siswa, lalu tekan Mulai." />
            <TextBlock x:Name="YawText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#AAAAAA" FontSize="13" />
            <TextBlock x:Name="LangkahText" DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="#4ADE80" FontSize="14" />
            <Border Background="Black" CornerRadius="6">
                <Image x:Name="KameraImage" Stretch="Uniform" />
            </Border>
        </DockPanel>

        <!-- Kanan: kelas, daftar siswa (urut abjad), tombol -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="Kelas" Foreground="#AAAAAA" Margin="0,0,0,4" />
            <ComboBox x:Name="KelasCombo" DockPanel.Dock="Top" Margin="0,0,0,8" SelectionChanged="KelasCombo_SelectionChanged" />
            <TextBlock x:Name="InfoText" DockPanel.Dock="Top" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Tanda: ✓ lengkap, ◐ sebagian, ○ belum. Orang tua tetap bisa melihat status dan mendaftar ulang dari aplikasi HP." />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="MulaiButton" Content="Mulai Daftar Siswa Terpilih" Padding="12,10" Margin="0,0,0,8" IsEnabled="False" Click="Mulai_Click" />
                <Button x:Name="BerhentiButton" Content="Berhenti" Padding="12,8" Margin="0,0,0,8" IsEnabled="False" Click="Berhenti_Click" />
                <Button Content="Tutup" Padding="12,8" Click="Tutup_Click" />
            </StackPanel>
            <ListBox x:Name="SiswaList" DisplayMemberPath="Tampil" SelectionChanged="SiswaList_SelectionChanged" />
        </DockPanel>
    </Grid>
</Window>
