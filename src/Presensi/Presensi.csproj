<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Multi-target SENGAJA (2026-08-31, keputusan user): net48 utk PC
      Windows 7 SP1 ke atas yang masih dipakai sekolah, net8.0-windows
      utk PC Windows 10/11 modern - SATU codebase, SATU repo, CI build
      MENGHASILKAN 2 installer terpisah tiap kali rilis. Jangan pisah jadi
      2 project/repo - nyaris seluruh kode (UI, logic kamera/scanner)
      sama persis, cuma target runtime yang beda.
    -->
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- LangVersion dipaksa "latest" utk KEDUA target - net48 secara
         DEFAULT cuma dapat C# 7.3 dari SDK modern, padahal fitur bahasa
         (namespace file-scoped, dll) yang dipakai di sini butuh C# 10+.
         Ini aman: fitur bahasa murni compile-time, tidak bergantung API
         runtime yang tidak ada di net48. -->
    <LangVersion>latest</LangVersion>
    <AssemblyName>Presensi</AssemblyName>
    <RootNamespace>Presensi</RootNamespace>
    <!-- Logo resmi SDIT Al-Ikhlas / YAI 86 - sumber sama dgn ikon aplikasi
         native (Mobile-app/Aplikasi/assets/icon.png), dikonversi ke .ico
         multi-resolusi (16-256px) via Pillow. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <!-- Windows 7 tidak pernah dapat .NET 8 - baris ini murni informatif,
         pemisahan runtime SUNGGUHAN terjadi via TargetFrameworks di atas. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net8.0-windows'">7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenCvSharp4 - satu-satunya library kamera yang dikonfirmasi jalan
         di KEDUA target (net48 & net8.0-windows) dari 1 referensi yang
         sama, jadi kode capture kamera tidak perlu #if TARGET beda-beda. -->
    <PackageReference Include="DlibDotNet" Version="19.21.0.20220724" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.WpfExtensions" Version="4.10.0.20241108" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paket NuGet System.IO.Ports (BUKAN <Reference> assembly klasik) -
         dipakai utk KEDUA target sekaligus, resmi mendukung net461+ jadi
         net48 ikut ter-cover dari 1 baris yang sama, tidak perlu cabang
         per-target lagi. -->
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource (bukan cuma ApplicationIcon) - supaya Icon="Assets/app.ico"
         di MainWindow.xaml (ikon title bar/taskbar saat aplikasi JALAN)
         ikut ter-pack, bukan cuma ikon .exe di File Explorer. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Disertakan ke folder hasil publish/build (bukan cuma di source) -
         supaya orang yang install dari artifact CI langsung ketemu
         contohnya di sebelah Presensi.exe, tidak perlu buka source code. -->
    <None Include="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 3 filter contoh (ORIGINAL, dibuat sendiri lewat script Pillow - lihat
         Projek.md soal alasannya bukan diunduh dari internet) - disalin ke
         folder filter user PERTAMA KALI aplikasi jalan (lihat
         FilterManager.EnsureSeeded()), supaya langsung ada yang bisa dicoba
         tanpa perlu upload dulu. Termasuk .png (bingkai statis) MAUPUN
         .stiker (bundle nempel-wajah, lihat FaceStickerFilter). -->
    <None Include="Assets\SampleFilters\*.png;Assets\SampleFilters\*.stiker" CopyToOutputDirectory="PreserveNewest">
      <Link>SampleFilters\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Reference assemblies net48 LENGKAP dari NuGet (bukan andalkan yang
         kebetulan terpasang di mesin/CI) - build jadi 100% reproducible,
         tidak bergantung Visual Studio full/dev-pack apa yang terinstal
         di komputer manapun (lokal maupun runner GitHub Actions). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- net8.0-windows sudah punya HttpClient & System.Text.Json bawaan -
         net48 (klasik) butuh paket NuGet terpisah utk keduanya. -->
    <Reference Include="System.Net.Http" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- ZipFile (System.IO.Compression.ZipFile) - dipakai FaceStickerFilter
         baca bundle .stiker - di .NET Framework klasik ada di assembly
         TERPISAH (System.IO.Compression.FileSystem), tidak seperti
         net8.0-windows yang sudah menyatu di SDK. -->
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
