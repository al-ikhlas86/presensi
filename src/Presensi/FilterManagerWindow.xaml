<Window x:Class="Presensi.FilterManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kelola Filter"
        Icon="Assets/app.ico"
        Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="#1A1D1F"
        Closing="Window_Closing">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Upload .png (bingkai statis di seluruh layar) atau .stiker (nempel &amp; ikut gerak wajah, mis. astronot/kacamata). Filter &quot;Normal&quot; adalah bawaan dan tidak bisa dihapus." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="UploadButton" Content="Upload Filter (.png)..." Padding="12,8" Margin="0,0,8,0" Click="Upload_Click" />
            <Button x:Name="DeleteButton" Content="Hapus Terpilih" Padding="12,8" IsEnabled="False" Click="Delete_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Tutup" Padding="16,8" Click="Close_Click" />
        </StackPanel>

        <ListBox x:Name="FilterListBox" DisplayMemberPath="DisplayName" SelectionChanged="FilterListBox_SelectionChanged" />
    </DockPanel>
</Window>
