<Window x:Class="Presensi.UpdateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presensi Al-Ikhlas 86"
        Icon="Assets/app.ico"
        Width="420" Height="170"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#1A1D1F">
    <Border BorderBrush="#356447" BorderThickness="1" CornerRadius="12">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="Presensi Al-Ikhlas 86" FontSize="16" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,14" />
            <TextBlock x:Name="StatusText" Text="Memeriksa pembaruan..." Foreground="#E5E7EB" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" />
        </StackPanel>
    </Border>
</Window>
