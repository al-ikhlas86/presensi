<Window x:Class="Presensi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Jam Presensi"
        Icon="Assets/app.ico"
        SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1D1F">
    <StackPanel Margin="20">
        <TextBlock Text="Sebelum jam Pulang = otomatis mode MASUK." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,4" />
        <TextBlock Text="Jam Pulang ke atas = otomatis mode PULANG." Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,0,0,16" />

        <TextBlock Text="Jam Masuk (informasi saja, format HH:mm)" Foreground="White" Margin="0,0,0,4" />
        <TextBox x:Name="JamMasukBox" Padding="8" FontSize="16" Margin="0,0,0,16" />

        <TextBlock Text="Jam Pulang (batas ganti mode, format HH:mm)" Foreground="White" Margin="0,0,0,4" />
        <TextBox x:Name="JamPulangBox" Padding="8" FontSize="16" Margin="0,0,0,16" />

        <TextBlock Text="Mode Tampilan Jendela" Foreground="White" Margin="0,0,0,4" />
        <ComboBox x:Name="DisplayModeCombo" Padding="8" FontSize="14" Margin="0,0,0,16">
            <ComboBoxItem Content="Ukuran Default (1024x720)" Tag="default" />
            <ComboBoxItem Content="Bebas (ukuran terakhir dipertahankan)" Tag="bebas" />
            <ComboBoxItem Content="Layar Penuh (Fullscreen)" Tag="fullscreen" />
            <ComboBoxItem Content="Jendela rasio 4:3" Tag="4:3" />
            <ComboBoxItem Content="Jendela rasio 16:9" Tag="16:9" />
            <ComboBoxItem Content="Jendela rasio 1:1 (persegi)" Tag="1:1" />
        </ComboBox>

        <CheckBox x:Name="ShowRiwayatPanelCheck" Content="Tampilkan panel &quot;Presensi Terbaru&quot; di kanan" Foreground="White" Margin="0,0,0,16" />

        <TextBlock x:Name="ErrorText" Foreground="#F87171" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" Padding="16,8" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Simpan" Padding="16,8" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
