<Window x:Class="Presensi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presensi - Al-Ikhlas 86"
        Icon="Assets/app.ico"
        Height="720" Width="1024"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1A1D1F"
        Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RiwayatSpacerColumn" Width="16" />
            <ColumnDefinition x:Name="RiwayatPanelColumn" Width="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Presensi Al-Ikhlas 86" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                <!-- Mode Masuk/Pulang OTOMATIS berdasar jam PC + jadwal di Pengaturan -
                     tidak ada lagi toggle manual (lihat ScheduleService.GetCurrentMode). -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ModeText" Text="Mode: MASUK" FontSize="18" FontWeight="Bold" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="ModeScheduleText" Text="(otomatis - ganti jam 15:00)" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- Preview area -->
            <Border Grid.Row="1" Background="Black" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewOffText" Text="Preview dimatikan - presensi tetap berjalan di latar belakang"
                               Foreground="#888" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#CC000000" Padding="16,12">
                        <TextBlock x:Name="StatusText" Text="Menunggu wajah / scan kartu..." Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <!-- Banner update - MUNCUL cuma saat auto-update sedang
                         mengunduh/memasang (lihat UpdateService.StatusChanged
                         di code-behind). Ditambahkan 2026-09-01 - SEBELUM ini
                         TIDAK ADA tanda visual apa pun kalau app sedang
                         mengunduh update (~100MB, tidak instan), jadi user
                         berkali-kali menutup app di tengah unduhan mengira
                         "tidak terjadi apa-apa" - unduhan hangus tiap kali. -->
                    <Border x:Name="UpdateBanner" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="#E6B45309" Padding="16,12" Visibility="Collapsed">
                        <TextBlock x:Name="UpdateBannerText" Foreground="White" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <!-- Controls - WrapPanel TUNGGAL (BUKAN Grid 2 kolom spt percobaan
                 sebelumnya) - perbaikan Grid-2-kolom TERBUKTI MASIH terpotong
                 begitu tombol ke-6 (Sembunyikan Panel) ditambahkan, krn kolom
                 "*" cuma dapat SISA lebar setelah kolom "Auto" diambil duluan,
                 dan WPF MEMOTONG (bukan membungkus) konten yang melebihi jatah
                 kolomnya (dilaporkan user 2026-09-01, screenshot: "Kelola
                 Filter..." kepotong jadi "K", "Pengaturan..." hilang total).
                 WrapPanel TIDAK PERNAH memotong - kalau tidak muat 1 baris,
                 tombol otomatis lanjut ke baris berikutnya, apa pun jumlah
                 tombolnya & seberapa pun sempit jendelanya. -->
            <WrapPanel Grid.Row="2" Margin="0,12,0,0" Orientation="Horizontal">
                <TextBlock Text="Filter:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox x:Name="FilterCombo" Width="160" Margin="0,0,8,8" SelectionChanged="FilterCombo_SelectionChanged" />
                <Button x:Name="ManageFilterButton" Content="Kelola Filter..." Padding="12,8" Margin="0,0,8,8" Click="ManageFilterButton_Click" />
                <Button x:Name="SettingsButton" Content="Pengaturan..." Padding="12,8" Margin="0,0,8,8" Click="SettingsButton_Click" />
                <Button x:Name="ToggleRiwayatButton" Content="Sembunyikan Panel" Padding="16,8" Margin="0,0,8,8" Click="ToggleRiwayatButton_Click" />
                <Button x:Name="TogglePreviewButton" Content="Matikan Preview" Padding="16,8" Margin="0,0,8,8" Click="TogglePreviewButton_Click" />
                <Button x:Name="ScannerButton" Content="Sambungkan Scanner..." Padding="16,8" Margin="0,0,8,8" Click="ScannerButton_Click" />
            </WrapPanel>
        </Grid>

        <!-- Panel riwayat presensi - opsional (bisa dimatikan lewat Pengaturan,
             lihat ApplyRiwayatPanelVisibility di code-behind), diminta user
             2026-09-01. Tampil live tiap ada presensi berhasil (wajah MAUPUN
             scanner), krn keduanya sama-sama lewat HandleAttendanceResult
             satu pintu. -->
        <Border x:Name="RiwayatPanelBorder" Grid.Column="2" Background="#232629" CornerRadius="12" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Presensi Terbaru" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,4" />
                <TextBlock x:Name="ScannerStatusText" Grid.Row="1" Text="Scanner: belum tersambung" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,12" TextWrapping="Wrap" />
                <ListBox x:Name="RiwayatList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#E5E7EB" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
